#!/usr/bin/env python3
"""setup — the one command after cloning. No menus: you talk to the agent.

  git clone <repo> && cd <repo> && ./setup

Writes a persona (asks one question: a name), gets SOME brain runnable —
Claude Code is the default and the only full body (tools, self-editing),
but it is NOT a dependency: a local Ollama model or any OpenAI-style API
key (OpenRouter, Groq, …) works too, no Anthropic account required — then
wakes the agent for its FIRST CONVERSATION. The agent asks how you want it
to work and (when it has tools) installs what you ask for, per
skills/module. You start with ZERO modules beyond the engine you picked:
the lightest, fully-auditable configuration (`agent.py` is the whole
engine; read it).

The first conversation is remembered under the key "main" (your durable
thread: `./tui.sh --remember main`). Re-running setup is safe — it never
overwrites what exists and won't repeat the kickoff.
"""
import json
import os
import shutil
import subprocess
import sys
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))


def find_claude():
    """The claude binary: PATH first, then the installer's known homes."""
    hit = shutil.which(os.environ.get("CLAUDE_BIN", "claude"))
    if hit:
        return hit
    for p in ("~/.local/bin/claude", "~/.claude/local/claude"):
        p = os.path.expanduser(p)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def probe_ollama():
    """Installed model names if a local Ollama server answers, else None."""
    try:
        with urllib.request.urlopen("http://localhost:11434/api/tags",
                                    timeout=2) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        return [m.get("name") for m in data.get("models", []) if m.get("name")]
    except Exception:
        return None


def _get_json(url, timeout=1.5):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None


# Common local OpenAI-compatible servers (besides Ollama's native API).
LOCAL_SERVERS = [("LM Studio", 1234), ("vLLM", 8000),
                 ("llama.cpp", 8080), ("Jan", 1337)]
# API keys people commonly already have in their shell env → known base URLs.
KEY_BASES = [
    ("OPENROUTER_API_KEY", "https://openrouter.ai/api/v1"),
    ("OPENAI_API_KEY", "https://api.openai.com/v1"),
    ("GROQ_API_KEY", "https://api.groq.com/openai/v1"),
    ("DEEPSEEK_API_KEY", "https://api.deepseek.com/v1"),
    ("TOGETHER_API_KEY", "https://api.together.xyz/v1"),
    ("MISTRAL_API_KEY", "https://api.mistral.ai/v1"),
    ("XAI_API_KEY", "https://api.x.ai/v1"),
]


def scan_local():
    """Everything on this machine an agent could think with."""
    found = []
    c = find_claude()
    if c:
        found.append({"kind": "claude", "label": f"Claude Code CLI ({c})"})
    models = probe_ollama()
    if models is not None:
        found.append({"kind": "ollama", "models": models,
                      "label": f"Ollama server — {len(models)} model(s): "
                               f"{', '.join(models[:5])}"
                               + ("…" if len(models) > 5 else "")})
    elif shutil.which("ollama"):
        found.append({"kind": "note", "label":
                      "ollama is installed but the server isn't running "
                      "(`ollama serve`, then re-scan)"})
    for name, port in LOCAL_SERVERS:
        data = _get_json(f"http://localhost:{port}/v1/models")
        if isinstance(data, dict) and isinstance(data.get("data"), list):
            ids = [m.get("id") for m in data["data"] if m.get("id")]
            found.append({"kind": "oai-server", "name": name, "port": port,
                          "models": ids,
                          "label": f"{name} server on :{port} — "
                                   f"{', '.join(ids[:4]) or 'no models loaded'}"})
    for var, base in KEY_BASES:
        if os.environ.get(var, "").strip():
            found.append({"kind": "key", "var": var, "base": base,
                          "label": f"${var} in your environment → {base}"})
    for cli in ("codex", "gemini"):
        if shutil.which(cli):
            found.append({"kind": "note", "label":
                          f"`{cli}` CLI found — no engine module for it yet "
                          "(see TODO-MODULES.md; contributions welcome)"})
    return found


def bootstrap_from_scan():
    found = scan_local()
    if not found:
        print("\nscan: nothing usable found — no claude CLI, no local model "
              "server, no known API keys in env.")
        return None
    print("\nscan — usable brains on this machine:")
    usable = []
    for f in found:
        if f["kind"] == "note":
            print(f"      · {f['label']}")
        else:
            usable.append(f)
            print(f"  [{len(usable)}] {f['label']}")
    if not usable:
        return None
    pick = ask(f"use which? [1-{len(usable)}, Enter=1]: ", "1")
    try:
        f = usable[max(0, int(pick) - 1)]
    except (ValueError, IndexError):
        f = usable[0]
    if f["kind"] == "claude":
        return "claude" if bootstrap_claude() else None
    if f["kind"] == "ollama":
        return "engine-ollama" if bootstrap_ollama(f["models"]) else None
    if f["kind"] == "oai-server":
        models = f["models"]
        model = ask(f"model? {', '.join(models[:8])} "
                    f"[{models[0] if models else ''}]: ",
                    models[0] if models else "")
        if not model or not module_add("engine-oai"):
            return None
        env_write(ENGINE="engine-oai",
                  OAI_ENGINE_BASE_URL=f"http://localhost:{f['port']}/v1",
                  OAI_ENGINE_API_KEY="local", OAI_ENGINE_MODEL=model)
        print(f"engine: engine-oai → {f['name']} on :{f['port']} · {model} "
              "(local, keyless)")
        return "engine-oai"
    if f["kind"] == "key":
        model = ask("model id for that provider (e.g. qwen/qwen3-coder): ")
        if not model or not module_add("engine-oai"):
            return None
        env_write(ENGINE="engine-oai", OAI_ENGINE_BASE_URL=f["base"],
                  OAI_ENGINE_API_KEY=os.environ[f["var"]],
                  OAI_ENGINE_MODEL=model)
        print(f"engine: engine-oai → {f['base']} · {model} (key copied from "
              f"${f['var']} into the gitignored .env)")
        return "engine-oai"
    return None


def render(text):
    """Show the agent's reply the way the TUI would (markdown → ANSI)."""
    try:
        import importlib.machinery
        import importlib.util
        loader = importlib.machinery.SourceFileLoader(
            "clawd_cli", os.path.join(HERE, "adapters", "cli.py"))
        spec = importlib.util.spec_from_loader("clawd_cli", loader)
        cli = importlib.util.module_from_spec(spec)
        loader.exec_module(cli)
        if sys.stdout.isatty():
            return cli.render_markdown(text)
    except Exception:
        pass
    return text


def read_lock():
    entries = []
    try:
        with open(os.path.join(HERE, "modules.lock"), encoding="utf-8") as f:
            for line in f:
                parts = line.split()
                if len(parts) == 4 and parts[2] == "@":
                    entries.append((parts[0], parts[1], parts[3]))
    except OSError:
        pass
    return entries


def module_add(name):
    match = [e for e in read_lock() if e[0] == name]
    if not match:
        return False
    _n, url, sha = match[0]
    r = subprocess.run([sys.executable, os.path.join(HERE, "tools", "module"),
                        "add", url, name, "--sha", sha], cwd=HERE)
    return r.returncode == 0


def env_write(**kv):
    with open(os.path.join(HERE, ".env"), "a", encoding="utf-8") as f:
        for k, v in kv.items():
            f.write(f"{k}={v}\n")


def ask(prompt, default=""):
    try:
        return input(prompt).strip() or default
    except EOFError:
        return default


KICKOFF = """(first-run setup — from ./setup, not the human) You were just
cloned and have no modules installed beyond your engine: the lightest,
fully-auditable configuration. Greet your human briefly, then ask them —
in plain language, no menus — how they want you to work. Offer a few
hints, one short line each: the pinned-but-not-installed modules are
{mods} (read modules.lock and each module's repo for details); channels
like telegram are modules too. Don't guess at what a module does — you
haven't read them yet; describe one only if you're sure, otherwise just
name it and note you'd read it before installing. If they want nothing, that's a great
answer — stay minimal. Keep it short and warm. {powers} Their reply comes
through this same conversation."""

POWERS_CLAUDE = """You run on the claude engine, so you have real tools:
whatever they ask for, install and wire it yourself per skills/module
(audit first, verify after)."""

POWERS_CHAT = """You run on a chat engine ({eng}) — you have NO tools this
session: never pretend to run commands or invent output. When they want
something installed, give them the exact commands to run themselves
(tools/module add <name>; config lines for the gitignored .env), and note
that the claude engine is the only one that can act on its own."""


def bootstrap_claude():
    claude = find_claude()
    if not claude:
        ans = ask("install Claude Code now? (official installer, "
                  "https://claude.ai/install.sh) [Y/n]: ")
        # empty answer means yes only on a real keyboard — a piped/EOF run
        # must never curl|bash by default
        if not (ans.lower().startswith("y")
                or (ans == "" and sys.stdin.isatty())):
            return None
        if subprocess.call("curl -fsSL https://claude.ai/install.sh | bash",
                           shell=True) != 0:
            print("installer failed — see https://docs.claude.com/en/docs/claude-code")
            return None
        claude = find_claude()
        if not claude:
            print("installer left no runnable `claude` — see the docs above")
            return None
    os.environ["CLAUDE_BIN"] = claude
    if not shutil.which("claude"):
        env_write(CLAUDE_BIN=claude)   # engine reads .env; PATH not required
        print(f"claude: using {claude} (saved as CLAUDE_BIN in .env)")
    return claude


def bootstrap_ollama(models):
    if not models:
        print("\nOllama isn't running here yet. Install + get a model "
              "(free, fully local):")
        print("  macOS:  brew install ollama   ·   Linux:  curl -fsSL "
              "https://ollama.com/install.sh | sh")
        print("  then:   ollama pull qwen3:4b     # smallest model that "
              "works as an agent")
        print("re-run ./setup once `ollama list` shows a model.")
        return False
    # measured floor (see engine-ollama MODULE.md): 4b is the smallest model
    # that actually works as an agent; never default below it
    pref = ("qwen3:4b", "qwen3:8b", "qwen3:14b")
    default = next((m for m in pref if m in models),
                   next((m for m in models if m.startswith("qwen")
                         and "1.7b" not in m), models[0]))
    model = ask(f"which model? {', '.join(models[:8])} [{default}]: ", default)
    if not module_add("engine-ollama"):
        print("couldn't install engine-ollama (network? modules.lock?)")
        return False
    env_write(ENGINE="engine-ollama", OLLAMA_ENGINE_MODEL=model)
    print(f"engine: engine-ollama · {model} — local, free, chat-only "
          "(OLLAMA_ENGINE_TOOLS=bash exists; read its MODULE.md first)")
    return True


def bootstrap_openai():
    if shutil.which("codex"):
        print("(found the `codex` CLI — no engine module wraps it yet, see "
              "TODO-MODULES.md;\nwiring the OpenAI API instead)")
    envkey = os.environ.get("OPENAI_API_KEY", "").strip()
    key = ask("OpenAI API key" + (" [found $OPENAI_API_KEY — Enter to use it]"
                                  if envkey else "") + ": ", envkey)
    if not key:
        print("no key — get one at https://platform.openai.com, then re-run")
        return False
    model = ask("model id (see platform.openai.com/docs/models, "
                "e.g. gpt-5-mini): ")
    if not model or not module_add("engine-oai"):
        return False
    env_write(ENGINE="engine-oai",
              OAI_ENGINE_BASE_URL="https://api.openai.com/v1",
              OAI_ENGINE_API_KEY=key, OAI_ENGINE_MODEL=model)
    print(f"engine: engine-oai → api.openai.com · {model} — metered API, "
          "chat-only (key stays in the gitignored .env)")
    return True


def bootstrap_oai():
    base = ask("API base URL [https://openrouter.ai/api/v1]: ",
               "https://openrouter.ai/api/v1")
    key = ask("API key: ")
    if not key:
        print("no key — nothing to wire")
        return False
    model = ask("model id (e.g. qwen/qwen3-coder): ")
    if not module_add("engine-oai"):
        print("couldn't install engine-oai (network? modules.lock?)")
        return False
    env_write(ENGINE="engine-oai", OAI_ENGINE_BASE_URL=base,
              OAI_ENGINE_API_KEY=key, OAI_ENGINE_MODEL=model or "")
    print("engine: engine-oai — metered API, chat-only (key stays in the "
          "gitignored .env)")
    return True


def main():
    print("claude-p-agent setup — an agent is a brain in a directory,")
    print("with a persona and tools. The engine is agent.py; audit it first.\n")

    # 1. persona — the one typed question
    persona = os.path.join(HERE, "CLAUDE.md")
    if os.path.isfile(persona):
        print("persona: CLAUDE.md already exists — keeping it")
    else:
        name = ask("What should your agent be called? [Agent]: ", "Agent")
        with open(os.path.join(HERE, "CLAUDE.md.example"), encoding="utf-8") as f:
            text = f.read()
        text = text.split("-->", 1)[-1].lstrip()          # drop template banner
        with open(persona, "w", encoding="utf-8") as f:
            f.write(text.replace("<AGENT NAME>", name))
        print(f"persona: wrote CLAUDE.md — your agent is {name!r} (edit anytime)")

    # 2. some brain must be runnable — Claude Code is the default, not a dependency
    engine = os.environ.get("ENGINE")                 # respect an existing .env
    if not engine:
        claude = find_claude()
        if claude:
            os.environ["CLAUDE_BIN"] = claude
            engine = "claude"
            print("engine: claude (found the CLI — full body: tools, "
                  "self-editing)")
        else:
            models = probe_ollama()
            print("\nNo Claude Code here. Your agent needs a brain — any of:")
            print("  [s] scan this machine for anything usable (default)")
            print("  [c] Claude Code — the full body; needs a Claude "
                  "subscription")
            print("  [g] OpenAI — Codex / GPT models (API key)")
            print("  [o] local Ollama — free, private"
                  + (f"; running with {len(models)} model(s)" if models
                     else "; not running yet"))
            print("  [k] any OpenAI-style API key — OpenRouter, Groq, …")
            pick = ask("which? [s/c/g/o/k]: ", "s").lower()[:1]
            if pick == "s":
                engine = bootstrap_from_scan()
                if not engine:
                    print("re-run ./setup anytime.")
                    return 0
            elif pick == "o":
                if not bootstrap_ollama(models):
                    return 0
                engine = "engine-ollama"
            elif pick == "g":
                if not bootstrap_openai():
                    return 0
                engine = "engine-oai"
            elif pick == "k":
                if not bootstrap_oai():
                    return 0
                engine = "engine-oai"
            else:
                if not bootstrap_claude():
                    print("re-run ./setup anytime — or pick [o]/[k] next time.")
                    return 0
                engine = "claude"

    # 3. hand over to the agent — the rest of setup is a conversation
    if not sys.stdin.isatty():
        print("\n(non-interactive run: skipping the first conversation — "
              "run ./tui.sh to talk)")
        return 0
    mem = os.path.join(HERE, ".memory")
    kicked = any(f.startswith(("main.", "main@"))
                 for f in (os.listdir(mem) if os.path.isdir(mem) else []))
    if not kicked:
        print("\nwaking your agent (one moment)…\n")
        sys.path.insert(0, HERE)
        from agent import run_turn
        eng = os.environ.get("ENGINE") or engine or "claude"
        mods = ", ".join(n for n, _u, _s in read_lock()) or "none yet"
        powers = POWERS_CLAUDE if eng == "claude" else POWERS_CHAT.format(eng=eng)
        # owner's console: full hands on claude (guard hook still fires);
        # external engines take no claude CLI flags
        extra = (["--permission-mode", "bypassPermissions"]
                 if eng == "claude" else None)
        try:
            print(render(run_turn(KICKOFF.format(mods=mods, powers=powers),
                                  remember="main", extra_args=extra)))
        except Exception as e:
            if eng == "claude" and find_claude():
                print("\nThat failed — most likely you're not signed in yet.")
                print("Opening Claude Code for a one-time login: complete the")
                print("browser sign-in, then EXIT it (/exit) to continue.\n")
                subprocess.call([os.environ.get("CLAUDE_BIN", "claude")])
                try:
                    print(render(run_turn(
                        KICKOFF.format(mods=mods, powers=powers),
                        remember="main", extra_args=extra)))
                except Exception as e2:
                    print(f"[error] still failing: {e2}", file=sys.stderr)
                    return 1
            else:
                print(f"[error] first turn failed: {e}", file=sys.stderr)
                return 1
    print("\n(answer in the prompt below — same conversation, key 'main')\n")
    tui = os.path.join(HERE, "tui.sh")
    os.execv(tui, [tui, "--remember", "main"])


if __name__ == "__main__":
    sys.exit(main())
